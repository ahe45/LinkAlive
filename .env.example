NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

DATABASE_URL=mysql://linkalive:linkalive@localhost:3306/linkalive
REDIS_URL=redis://localhost:6379

# Applied only by the explicit `pnpm db:retention` maintenance command.
RETENTION_CHECK_RESULT_DAYS=30
RETENTION_HISTORY_DAYS=365
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_STEP=100

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-running
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=linkalive_session
COOKIE_SECURE=false

# 32-byte key encoded as base64. Example generation: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

CHECK_QUEUE_NAME=linkalive-checks
NOTIFICATION_QUEUE_NAME=linkalive-notifications
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_DUE_BATCH_SIZE=100
SCHEDULER_DISPATCH_BATCH_SIZE=200
SCHEDULER_HEALTH_PORT=4101
SCHEDULED_CHECK_LEASE_MS=300000
CHECK_WORKER_CONCURRENCY=25
# Shared by API manual/test checks and every worker replica. The lease must
# exceed the checker's hard 30-second request ceiling.
DESTINATION_CHECK_MAX_CONCURRENCY=4
DESTINATION_CHECK_MAX_PER_MINUTE=60
DESTINATION_CHECK_LEASE_MS=45000
DESTINATION_LIMIT_REDIS_TIMEOUT_MS=1000
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_LEASE_MS=60000
OUTBOX_POLL_INTERVAL_MS=2000
WORKER_HEALTH_PORT=4102
WORKER_HEALTH_PROBE_TIMEOUT_MS=2000
# Defaults to twice SCHEDULED_CHECK_LEASE_MS when omitted outside Compose.
WORKER_CHECK_PIPELINE_STALE_AFTER_MS=600000
WORKER_CHECK_FAILURE_THRESHOLD=3
WORKER_REGION=default
APP_BASE_URL=http://localhost:3001
# A system-wide Telegram bot token. Leave empty to disable Telegram delivery.
TELEGRAM_BOT_TOKEN=

LOG_LEVEL=info
TRUST_PROXY=false
